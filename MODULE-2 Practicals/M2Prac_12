import com.github.tototoshi.csv._
import java.io.File

object OneHotEncoding {

  def main(args: Array[String]): Unit = {

    // Read the CSV file
    val reader = CSVReader.open(new File("seeds_dataset - seeds.csv"))
    val data = reader.allWithHeaders()
    reader.close()

    // Get unique varieties
    val categories = data.map(_("varieties")).distinct.sorted

    // Perform One-Hot Encoding
    val newData = data.map { row =>
      val species = row("varieties")

      val oneHot = categories.map(cat =>
        cat -> (if (cat == varieties) "1" else "0")
      ).toMap

      (row - "varieties") ++ oneHot
    }

    // Print the header
    val headers = newData.head.keys.toList
    println(headers.mkString(", "))

    // Print each one-hot encoded row
    newData.foreach { row =>
      println(headers.map(row).mkString(", "))
    }

    // Write output to new CSV file
    val writer = CSVWriter.open(new File("seeds_dataset - seeds_encoded.csv"))

    writer.writeRow(headers)

    newData.foreach { row =>
      writer.writeRow(headers.map(row))
    }

    writer.close()

    println("One-hot encoded file written to seeds_dataset - seeds_encoded.csv")
  }
}
